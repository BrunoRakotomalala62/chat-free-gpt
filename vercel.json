{
  "version": 2,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/plot.js": {
      "maxDuration": 60
    },
    "api/geo.js": {
      "maxDuration": 60
    },
    "api/pdf.js": {
      "maxDuration": 60
    },
    "api/scrape.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/(plot|figure)",
      "dest": "/api/plot.js"
    },
    {
      "src": "/api/geo",
      "dest": "/api/geo.js"
    },
    {
      "src": "/api/pdf",
      "dest": "/api/pdf.js"
    },
    {
      "src": "/api/scrape",
      "dest": "/api/scrape.js"
    }
  ]
}
