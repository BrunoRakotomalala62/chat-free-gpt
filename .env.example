# ==============================================================================
# chat-free-gpt — variables d'environnement (routes vocales)
# À coller dans Vercel > Settings > Environment Variables.
#
# Les routes /api/chat, /api/plot et /api/geo n'utilisent AUCUNE variable.
# ==============================================================================

# --- STT : reconnaissance vocale (audio -> texte) -----------------------------
# Recommandé : une clé Groq gratuite couvre le STT ET le LLM.
#   -> https://console.groq.com/keys
GROQ_API_KEY=
# groq | openai | mock | (vide = auto)
STT_PROVIDER=
# Modèle STT (défaut : whisper-large-v3-turbo)
STT_MODEL=
# Langue forcée (ex. fr) — vide = détection automatique
STT_LANGUAGE=fr
# Alternative compatible OpenAI
STT_BASE_URL=
STT_API_KEY=

# --- LLM : génération de la réponse ------------------------------------------
# groq | openai | chat-endpoint | none | mock
# none = pas de LLM : /api/voice renvoie le transcript tel quel
LLM_PROVIDER=
# Modèle LLM Groq (défaut : openai/gpt-oss-120b).
# ⚠️ Groq déprécie souvent ses modèles : llama-3.3-70b-versatile et
# llama-3.1-8b-instant ne sont plus accessibles aux offres gratuite/developer
# depuis le 2026-08-16. Liste à jour : https://console.groq.com/docs/models
# Si le modèle choisi disparaît, lib/providers.js réessaie automatiquement avec
# openai/gpt-oss-120b puis openai/gpt-oss-20b.
GROQ_LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Endpoint de chat gratuit déjà déployé, ex. https://<projet>.vercel.app/api/chat
CHAT_ENDPOINT=

# --- TTS : synthèse vocale (texte -> audio) — AUCUNE CLÉ NÉCESSAIRE ------------
# fr-FR-DeniseNeural, fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural, ...
TTS_VOICE=fr-FR-DeniseNeural
TTS_TIMEOUT_MS=30000
TTS_MAX_CHARS=3000

# --- Édition d'image : routes /api/image-edit et /api/image-models ----------------
# Fournisseur : Magic Hour (https://docs.magichour.ai). Clé à créer sur
#   -> https://magichour.ai/developer  (crédits gratuits à l'inscription)
# Sans clé, /api/image-edit renvoie une erreur 500 « config_error » et
# /api/image-models reste consultable (catalogue statique).
MAGIC_HOUR_API_KEY=
# magichour | mock | (vide = auto : magichour si la clé est présente)
IMAGE_EDIT_PROVIDER=
# Modèle par défaut. Gratuits : flux-2-klein (5 cr), qwen-edit (10 cr), krea-2 (10 cr).
IMAGE_EDIT_MODEL=flux-2-klein
# 640px est la résolution gratuite ; 1k/2k nécessitent un plan payant selon le modèle.
IMAGE_EDIT_RESOLUTION=640px
IMAGE_EDIT_ASPECT_RATIO=auto
# Budget d'attente du mode synchrone (wait=1) et intervalle de sondage.
IMAGE_EDIT_WAIT_MS=40000
IMAGE_EDIT_POLL_MS=2000
# Délai maximal d'un appel Magic Hour.
IMAGE_EDIT_TIMEOUT_MS=45000
# Taille maximale acceptée pour une image (octets). Plafond Vercel ~4,5 Mo.
IMAGE_EDIT_MAX_BYTES=

# --- Divers -------------------------------------------------------------------
CORS_ORIGIN=*
# Optionnel : si défini, exige ?key=... ou l'en-tête x-api-key
API_KEY=